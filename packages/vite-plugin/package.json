{
  "name": "vite-plugin-bidilens",
  "version": "1.0.0",
  "description": "Vite plugin that audits CSS, SCSS, Sass, and Vue <style> blocks for hardcoded physical directional CSS during dev and CI builds.",
  "license": "MIT",
  "keywords": [
    "vite",
    "vite-plugin",
    "css",
    "sass",
    "rtl",
    "ltr",
    "bidi",
    "logical-properties",
    "vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@bidilens/core": "^1.0.0",
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  }
}
