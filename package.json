{
  "name": "bidilens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BidiLens — Bidirectional CSS & Sass Logical Property Ecosystem (@bidilens/core, Web Workbench, VS Code Extension, and Vite Plugin).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bidilens/web",
    "build:core": "npm run build --workspace=@bidilens/core",
    "build:plugin": "npm run build --workspace=vite-plugin-bidilens",
    "build:vscode": "npm run build --workspace=bidilens-vscode",
    "build:web": "npm run build --workspace=@bidilens/web",
    "build": "npm run build:core && npm run build:plugin && npm run build:vscode && npm run build:web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "esbuild": "^0.25.0",
    "happy-dom": "^17.1.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
